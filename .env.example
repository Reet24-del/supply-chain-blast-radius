# FalkorDB server (docker compose up -d, or FalkorDB Cloud)
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_USERNAME=
FALKORDB_PASSWORD=
FALKORDB_GRAPH=supplychain
# true on paid FalkorDB Cloud tiers; the Free tier has no TLS.
# FALKORDB_TLS=true

# Or run embedded FalkorDBLite instead of a server (no Docker; pip install '.[lite]').
# FALKORDB_LITE_PATH=.falkordb/lite.db

# Chat UI (uv run blast-web). Set one key; Groq's free tier needs no card (console.groq.com).
GROQ_API_KEY=
# ANTHROPIC_API_KEY=
# LLM_PROVIDER=groq            # or anthropic; default: groq if GROQ_API_KEY is set
# BLAST_MODEL=openai/gpt-oss-120b   # Groq default; claude-opus-5-5 for Anthropic
# BLAST_EFFORT=low                  # Groq default; medium for Anthropic

# Public deployments: questions per visitor per window, and per day across everyone.
# RATE_LIMIT_PER_VISITOR=15
# RATE_LIMIT_WINDOW_SECONDS=600
# DAILY_QUESTION_LIMIT=400

# open_issue only posts to GitHub when both are set; otherwise it writes to outbox/.
# Use a sandbox repo you own. Never point this at the real upstream projects.
GITHUB_TOKEN=
DEMO_ISSUES_REPO=
